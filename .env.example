# Copy to .env and fill in. Never commit .env.

# Required: the dashboard's sign-in password (holds your TR PIN, pick a strong one).
TRDASH_PASSWORD=

# Hostname(s) you open the dashboard with, comma-separated (server IP or domain).
# localhost and 127.0.0.1 are always allowed.
TRDASH_ALLOWED_HOSTS=tr.example.com

# 1 when a reverse proxy terminates HTTPS in front of the container
# (sets secure cookies and trusts X-Forwarded-Proto/Host).
TRDASH_BEHIND_PROXY=1

# Only needed if the browser origin differs from the Host the app sees.
# TRDASH_CSRF_TRUSTED_ORIGINS=https://tr.example.com

# Host interface / port to publish on (compose only).
# TRDASH_BIND=127.0.0.1
# TRDASH_PUBLISH_PORT=8085

# TRDASH_TIME_ZONE=Europe/Berlin
# Trade Republic web build sent at login; bump when TR redeploys.
# TR_WEB_APP_VERSION=2.2645.8
